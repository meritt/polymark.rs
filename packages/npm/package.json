{
  "name": "@meritt/polymark-wasm",
  "version": "0.1.0",
  "description": "Converts text between plain text, Markdown, HTML, rich text and Telegram MarkdownV2 through one document model, in WebAssembly",
  "keywords": [
    "converter",
    "html",
    "markdown",
    "telegram",
    "wasm",
    "webassembly"
  ],
  "license": "MIT",
  "author": {
    "name": "Alexey Simonenko",
    "email": "alexey@simonenko.dev",
    "url": "https://simonenko.xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meritt/polymark.rs.git",
    "directory": "packages/npm"
  },
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "sideEffects": false,
  "exports": {
    ".": "./polymark.js",
    "./polymark.wasm": "./polymark.wasm"
  },
  "files": [
    "polymark.js",
    "polymark.wasm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "error"
    }
  }
}
